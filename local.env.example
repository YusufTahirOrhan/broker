# scripts/local-run.sh (ya da local-run.ps1) bu dosyanın kopyasını okur: cp local.env.example local.env
# local.env git'e girmez. Değerler DEV'in; adresleri ve şifreleri DBA'dan / DEV ortam ayarlarından alın.
# Ayrıntılar: docs/local-run.md

# --- Merkezi admin (yapi-admin): DEV Oracle'da YEREL için açılmış bir şema, DEV'in merkezi şeması değil ---
YAPI_ADMIN_DB_URL=jdbc:oracle:thin:@//dev-oracle.example.local:1521/DEVPDB
YAPI_ADMIN_DB_USER=yapi_admin_local
YAPI_ADMIN_DB_PASSWORD=
YAPI_ADMIN_DB_SCHEMA=YAPI_ADMIN_LOCAL

# --- Broker (yapi-runtime): DEV'in runtime DB'si, salt okunur kullanıcı ---
YAPI_DEV_RUNTIME_DB_URL=jdbc:oracle:thin:@//dev-oracle.example.local:1521/DEVPDB
YAPI_DEV_RUNTIME_DB_USER=yapi_runtime_reader
YAPI_DEV_RUNTIME_DB_PASSWORD=
YAPI_DEV_RUNTIME_DB_SCHEMA=YAPI_RUNTIME

# --- Ortam Admin API'si (yapi-env-admin), yalnızca taşıma akışı denenecekse: YEREL runtime şeması ---
YAPI_RUNTIME_DB_URL=jdbc:oracle:thin:@//dev-oracle.example.local:1521/DEVPDB
YAPI_RUNTIME_DB_USER=yapi_runtime_local
YAPI_RUNTIME_DB_PASSWORD=
YAPI_RUNTIME_DB_SCHEMA=YAPI_RUNTIME_LOCAL

# --- DEV Redis: oturumlar (user:session:{uid}) ve route değişikliği sinyali ---
YAPI_REDIS_HOST=dev-redis.example.local
YAPI_REDIS_PORT=6379
YAPI_REDIS_PASSWORD=

# --- Giriş servisi yerelde çalışıyorsa (scripts/local-run.sh login): broker onun oturumlarını okusun ---
# Yerel giriş servisi local:user:session:{uid}'e yazar; değişken yokken broker DEV'in user:session:{uid}'ini okur.
#YAPI_SESSION_KEY_PREFIX=local:
