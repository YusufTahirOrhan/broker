# scripts/local-run.sh (ya da local-run.ps1) bu dosyanın kopyasını okur: cp local.env.example local.env
# local.env git'e girmez. Değerler DEV'in; adresleri ve şifreleri DBA'dan / DEV ortam ayarlarından alın.
# Ayrıntılar: docs/local-run.md

# --- Merkezi admin (broker-admin): DEV Oracle'da YEREL için açılmış bir şema, DEV'in merkezi şeması değil ---
BROKER_ADMIN_DB_URL=jdbc:oracle:thin:@//dev-oracle.example.local:1521/DEVPDB
BROKER_ADMIN_DB_USER=broker_admin_local
BROKER_ADMIN_DB_PASSWORD=
BROKER_ADMIN_DB_SCHEMA=BROKER_ADMIN_LOCAL

# --- Broker (broker-runtime): DEV'in runtime DB'si, salt okunur kullanıcı ---
BROKER_DEV_RUNTIME_DB_URL=jdbc:oracle:thin:@//dev-oracle.example.local:1521/DEVPDB
BROKER_DEV_RUNTIME_DB_USER=broker_runtime_reader
BROKER_DEV_RUNTIME_DB_PASSWORD=
BROKER_DEV_RUNTIME_DB_SCHEMA=BROKER_RUNTIME

# --- Ortam Admin API'si (broker-env-admin), yalnızca taşıma akışı denenecekse: YEREL runtime şeması ---
BROKER_RUNTIME_DB_URL=jdbc:oracle:thin:@//dev-oracle.example.local:1521/DEVPDB
BROKER_RUNTIME_DB_USER=broker_runtime_local
BROKER_RUNTIME_DB_PASSWORD=
BROKER_RUNTIME_DB_SCHEMA=BROKER_RUNTIME_LOCAL

# --- DEV Redis: oturumlar (user:session:{uid}) ve route değişikliği sinyali ---
BROKER_REDIS_HOST=dev-redis.example.local
BROKER_REDIS_PORT=6379
BROKER_REDIS_PASSWORD=
